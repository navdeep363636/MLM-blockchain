# WalletConnect Cloud project id — required by RainbowKit.
# Get one free at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Chain: 97 = BSC Testnet, 56 = BSC Mainnet
NEXT_PUBLIC_CHAIN_ID=97

# Read-only RPC for the browser. Two are not available here — wagmi takes one
# transport per chain — so this is the endpoint that stayed up through the
# testnet deploy.
NEXT_PUBLIC_BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# Deployed contract addresses — BSC Testnet (chain 97), deployed 2026-08-31.
# Source of truth: MLM-contracts/deployments/bscTestnet.integration.json.
# With mttToken and staking set, CONTRACTS_CONFIGURED flips true and the UI stops
# showing demo figures — so a wrong address here means wrong numbers presented as
# real ones, not a visible failure.
NEXT_PUBLIC_MTT_TOKEN_ADDRESS=0x53AE1e2888C1703b3Acf818C1305bf411a86892B
NEXT_PUBLIC_STAKING_ADDRESS=0xce83252a19AfcC8B9C89ef44d3f2554b89C7Cb38
NEXT_PUBLIC_REFERRAL_DISTRIBUTOR_ADDRESS=0x6AE2AB55b420FEA264920F2944A5A1d729A94C8F
NEXT_PUBLIC_TEAM_VESTING_ADDRESS=0x723053F097E8de0D7C8DAc967cD4346d0366580F
NEXT_PUBLIC_ADVISORS_VESTING_ADDRESS=0xE1FB92AAF3190de8e2c24Dd342327F87fcfBBa29
# MTTPayout — the withdrawal settlement rail. Without it the withdrawal page can
# show the platform's own record of a payout but not the on-chain settlement that
# proves it, so useWithdrawalSettlement and usePayoutRail stay idle.
NEXT_PUBLIC_PAYOUT_ADDRESS=0x0af73E1bbe85526D5c74b34F6eA44E94861Ff827

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
# Base URL INCLUDING the version segment. Every call in the app speaks v1, so the
# version lives here rather than in ninety call sites.
#
# The socket server is derived from this URL's origin — it is not under the API
# prefix — so pointing this at a path is enough for both.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
