NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mtt
DB_PASSWORD=
DB_NAME=members_trail
DB_LOGGING=false
DB_SYNCHRONIZE=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

CHAIN_ID=97
BSC_RPC_URLS=https://bsc-testnet-rpc.publicnode.com
INDEXER_ENABLED=false

# Contract addresses, copied from MLM-contracts/deployments/<network>.json.
# The indexer watches only the contracts it has an address for, and logs which
# ones it is skipping at boot rather than pretending to be fully wired.
MTT_TOKEN_ADDRESS=
STAKING_ADDRESS=
REFERRAL_DISTRIBUTOR_ADDRESS=
TEAM_VESTING_ADDRESS=
ADVISORS_VESTING_ADDRESS=

# MTTPayout — the withdrawal settlement rail.
# Leave this unset and withdrawals fall back to a direct token.transfer from the
# relayer key, which means the always-online key custodies the rewards pool with
# no daily ceiling and no on-chain link to the withdrawal it settles. The
# fallback works, and warns on every single payout, because it is the design the
# rail exists to replace. Set it.
PAYOUT_ADDRESS=

# Oracle relayer. It may only call recordCommission inside the already-funded
# cap — it can never move funds. In production this must be an HSM/MPC
# reference (ORACLE_KMS_KEY_ID), never a raw key.
ORACLE_PRIVATE_KEY=
# ORACLE_KMS_KEY_ID=

QUEUE_WORKERS_ENABLED=true
SCHEDULER_ENABLED=false
EVENT_TRANSPORT=memory
