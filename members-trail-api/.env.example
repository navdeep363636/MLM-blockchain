NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mtt
DB_PASSWORD=
DB_NAME=members_trail
DB_LOGGING=false
DB_SYNCHRONIZE=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

CHAIN_ID=97
# Comma-separated, tried in order with automatic failover. Two entries is not
# belt-and-braces: the first testnet deploy attempt was lost to publicnode
# timing out mid-call, which is why data-seed leads here.
BSC_RPC_URLS=https://data-seed-prebsc-1-s1.binance.org:8545,https://bsc-testnet-rpc.publicnode.com
INDEXER_ENABLED=true

# Contract addresses — BSC Testnet (chain 97), deployed 2026-08-31.
# Source of truth: MLM-contracts/deployments/bscTestnet.integration.json.
# These are cross-checked at boot against modules/chain/deployment.ts and against
# the chain itself (bytecode present, every contract settling in this MTTToken);
# see GET /api/v1/admin/chain/deployment for the result.
MTT_TOKEN_ADDRESS=0x53AE1e2888C1703b3Acf818C1305bf411a86892B
STAKING_ADDRESS=0xce83252a19AfcC8B9C89ef44d3f2554b89C7Cb38
REFERRAL_DISTRIBUTOR_ADDRESS=0x6AE2AB55b420FEA264920F2944A5A1d729A94C8F
TEAM_VESTING_ADDRESS=0x723053F097E8de0D7C8DAc967cD4346d0366580F
ADVISORS_VESTING_ADDRESS=0xE1FB92AAF3190de8e2c24Dd342327F87fcfBBa29

# MTTPayout — the withdrawal settlement rail.
# Leave this unset and withdrawals fall back to a direct token.transfer from the
# relayer key, which means the always-online key custodies the rewards pool with
# no daily ceiling and no on-chain link to the withdrawal it settles. The
# fallback works, and warns on every single payout, because it is the design the
# rail exists to replace. Set it.
PAYOUT_ADDRESS=0x0af73E1bbe85526D5c74b34F6eA44E94861Ff827

# At or just before MTTToken's deployment block, so the first scan picks up the
# setup events (role grants, pool creation, the initial funding) and not only
# what happened after. Leaving this at 0 starts the scan at genesis and the
# indexer never reaches the head.
INDEXER_START_BLOCK=128242300

# Oracle relayer. It may only call recordCommission inside the already-funded
# cap — it can never move funds. In production this must be an HSM/MPC
# reference (ORACLE_KMS_KEY_ID), never a raw key.
#
# On this deployment ORACLE_ROLE and PAYER_ROLE were granted to
# 0xdD83d806789e199D7D4C079FEEE80523cd023AAf. A key for any other address boots
# fine and then reverts on every commission record and every payout, after
# spending gas and burning a nonce — so the boot check compares the two.
ORACLE_PRIVATE_KEY=
# ORACLE_KMS_KEY_ID=

QUEUE_WORKERS_ENABLED=true
SCHEDULER_ENABLED=false
EVENT_TRANSPORT=memory
