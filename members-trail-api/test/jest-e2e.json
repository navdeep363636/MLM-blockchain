{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "isolatedModules": true,
        "diagnostics": false
      }
    ]
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "setupFiles": [
    "<rootDir>/test/setup-e2e.ts"
  ],
  "testTimeout": 180000,
  "forceExit": true,
  "maxWorkers": 1
}
