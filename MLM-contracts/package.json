{
  "name": "members-trail-contracts",
  "version": "1.0.0",
  "description": "MTT (Members Trail Token) smart contracts for BNB Smart Chain \u2014 revenue-funded staking and referral distribution",
  "main": "index.js",
  "scripts": {
    "abi": "node scripts/export-abi.js",
    "check:local": "hardhat run scripts/post-deploy-check.js --network localhost",
    "check:mainnet": "hardhat run scripts/post-deploy-check.js --network bscMainnet",
    "check:testnet": "hardhat run scripts/post-deploy-check.js --network bscTestnet",
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network bscMainnet",
    "deploy:testnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "e2e": "hardhat run scripts/e2e-local.js",
    "exercise:local": "hardhat run scripts/exercise-all.js --network localhost",
    "fund:local": "hardhat run scripts/fund-pools.js --network localhost",
    "fund:mainnet": "hardhat run scripts/fund-pools.js --network bscMainnet",
    "fund:testnet": "hardhat run scripts/fund-pools.js --network bscTestnet",
    "node": "hardhat node",
    "payout:local": "hardhat run scripts/setup-payout.js --network localhost",
    "payout:mainnet": "hardhat run scripts/setup-payout.js --network bscMainnet",
    "payout:testnet": "hardhat run scripts/setup-payout.js --network bscTestnet",
    "pools:local": "hardhat run scripts/setup-pools.js --network localhost",
    "pools:mainnet": "hardhat run scripts/setup-pools.js --network bscMainnet",
    "pools:testnet": "hardhat run scripts/setup-pools.js --network bscTestnet",
    "preflight:local": "hardhat run scripts/preflight.js --network localhost",
    "preflight:mainnet": "hardhat run scripts/preflight.js --network bscMainnet",
    "preflight:testnet": "hardhat run scripts/preflight.js --network bscTestnet",
    "roles:local": "hardhat run scripts/setup-roles.js --network localhost",
    "roles:mainnet": "hardhat run scripts/setup-roles.js --network bscMainnet",
    "roles:testnet": "hardhat run scripts/setup-roles.js --network bscTestnet",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "verify:mainnet": "hardhat run scripts/verify.js --network bscMainnet",
    "verify:testnet": "hardhat run scripts/verify.js --network bscTestnet"
  },
  "keywords": [],
