# ============================================================
# Members Trail — Contract Deployment Configuration
# Copy to .env and fill in. NEVER commit .env to git.
# ============================================================

# --- Deployer (use a dedicated deploy key, funded with BNB for gas) ---
DEPLOYER_PRIVATE_KEY=

# --- RPC endpoints ---
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org

# --- BscScan verification ---
BSCSCAN_API_KEY=

# ============================================================
# PRODUCTION WALLETS — ALL MUST BE MULTISIGS (e.g. Gnosis Safe)
# deploy.js will REFUSE to run on mainnet if ADMIN_MULTISIG is unset.
# ============================================================

# Holds DEFAULT_ADMIN_ROLE on all contracts. 3-of-5 Safe recommended.
ADMIN_MULTISIG=

# Holds the 40% Play-to-Earn rewards allocation (funds Points->MTT conversions)
REWARDS_POOL_WALLET=

# Holds the 15% Treasury Reserve; also receives staking early-exit penalties
TREASURY_RESERVE_WALLET=

# Holds the 15% liquidity allocation (lock this in the DEX LP)
LIQUIDITY_WALLET=

# Holds the 10% marketing allocation
MARKETING_WALLET=

# Beneficiaries of the vesting contracts (15% team / 5% advisors)
TEAM_BENEFICIARY=
ADVISORS_BENEFICIARY=

# ============================================================
# OPERATIONAL ROLES (granted by scripts/setup-roles.js)
# ============================================================

# Calls fundRewardPool() and depositCommissionPool(). MUST be a multisig —
# this is the only address that can move real revenue into payout pools.
TREASURY_OPS_MULTISIG=

# Backend relayer that calls recordCommission(). Narrow permission: it can
# ONLY record entries within the already-funded cap; it cannot move funds.
# Use an HSM/MPC-managed key, not a plaintext private key.
BACKEND_ORACLE_ADDRESS=

# Sets KYC flags and performs clawbacks
COMPLIANCE_SIGNER_ADDRESS=

# Set to "true" to have setup-roles.js revoke the deployer's operational roles
REVOKE_DEPLOYER=false

# --- Optional ---
REPORT_GAS=false
